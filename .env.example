# demo runs with no PBX. live enables whichever connectors have credentials.
SOURCE=demo
HOST=0.0.0.0
PORT=8080
TIMEZONE=UTC
LOG_LEVEL=info

# Change these before the process is reachable beyond your laptop.
SESSION_SECRET=span-dev-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=span-demo-admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=span-demo-viewer
COOKIE_SECURE=0

LOW_BALANCE=5
# 0 freezes the demo floor. 1500 is a gentle tick. Minimum non-zero is 200.
SIM_TICK_MS=1500
SIM_SEED=20261114

# Asterisk Manager. Leave AMI_SECRET empty to keep AMI off.
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=span
AMI_SECRET=
AMI_RECONNECT_MS=5000

# Optional. Hangup prefers ARI when all three are set, and falls back to AMI.
ARI_URL=
ARI_USERNAME=
ARI_PASSWORD=

# MagnusBilling API root, including /mbilling/index.php
MAGNUS_URL=
MAGNUS_API_KEY=
MAGNUS_API_SECRET=

# FreePBX GraphQL. Token from: fwconsole api gen-token
FREEPBX_GRAPHQL_URL=
FREEPBX_TOKEN=

# Read-only user on asteriskcdrdb. See docs/freepbx.md.
CDR_HOST=
CDR_PORT=3306
CDR_USER=
CDR_PASSWORD=
CDR_DATABASE=asteriskcdrdb
